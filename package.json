{
  "name": "@cuny-ai-lab/cail-client",
  "version": "3.0.0",
  "description": "The CAIL model-proxy API client for CUNY applications: a pure Web-standard fetch wrapper that owns the credential, header, error, and retry contract. Runs unchanged in the browser, Cloudflare Workers, and Node >=20.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./contract/model-gateway-v1.json": "./contract/model-gateway-v1.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contract",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run check:format && bun run typecheck && bun run test && bun run check:dist && bun run check:package && bun run check:release-authority",
    "check:dist": "bun scripts/check-dist.ts",
    "check:format": "bun scripts/check-format.ts",
    "check:package": "bun pm pack --dry-run --ignore-scripts",
    "check:clean": "bun scripts/check-clean.ts",
    "check:publication-authority": "bun scripts/check-publication-authority.ts",
    "check:release-authority": "bun scripts/check-client-release-authority.ts",
    "check:release-ref": "bun scripts/check-client-release-ref.ts",
    "check:release-live": "bun scripts/check-client-release-authority.ts --live",
    "check:publication-preflight": "bun scripts/check-client-release-authority.ts --publication-preflight",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run check && bun run check:clean && bun run check:publication-authority && bun run check:release-ref && bun run check:publication-preflight",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-log": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "postcss": "8.5.25",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUNY-AI-Lab/cail-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
