{
  "name": "@cuny-ai-lab/cail-client",
  "version": "5.0.0",
  "description": "Small Web-standard helpers for CAIL error, catalog, quota, and native run extensions.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run check:format && bun run typecheck && bun run test && bun run check:dist && bun run check:package",
    "check:dist": "bun scripts/check-dist.ts",
    "check:format": "bun scripts/check-format.ts",
    "check:package": "bun pm pack --dry-run --ignore-scripts",
    "check:clean": "bun scripts/check-clean.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run check && bun run check:clean",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUNY-AI-Lab/cail-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
