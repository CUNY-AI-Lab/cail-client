{
  "name": "@cuny-ai-lab/cail-client",
  "version": "6.0.0",
  "description": "Web-standard CAIL Gateway transport with OpenAI-compatible chat and CAIL extensions.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint .",
    "check": "bun run lint && bun run check:format && bun run typecheck && bun run test && bun run build && bun run check:package",
    "check:format": "bun scripts/check-format.ts",
    "check:package": "bun pm pack --dry-run --ignore-scripts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run check",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^20.17.6",
    "oxlint": "1.79.0",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUNY-AI-Lab/cail-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
